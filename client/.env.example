# ---------------------------------------------------------------------------
# Life RPG — client environment
# Copy to `client/.env` and fill in. Vite only exposes VITE_-prefixed keys.
#
# These values are PUBLIC by design — a Firebase web config is meant to ship in
# the browser bundle. Access is controlled by Firebase Auth rules and by the
# API verifying every ID token server-side, not by hiding these strings.
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSy...your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Base URL of the Express API.
# Leave EMPTY in local development — vite.config.js proxies /api to port 4000.
# Set in production, e.g. https://life-rpg-api.onrender.com
VITE_API_URL=

# ---------------------------------------------------------------------------
# Development-only auth bypass (see README -> "Running without Firebase").
# Leave unset/false. Has no effect in a production build: it is additionally
# guarded by `import.meta.env.DEV`, which Vite compiles to `false`.
# Requires AUTH_DEV_BYPASS=true on the server to match.
# ---------------------------------------------------------------------------
VITE_AUTH_DEV_BYPASS=false
VITE_AUTH_DEV_UID=dev-user
